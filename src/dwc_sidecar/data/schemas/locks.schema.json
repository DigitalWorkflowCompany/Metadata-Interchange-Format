{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ns.the-dwc.com/sidecar/v0.2/locks.schema.json",
  "title": "DWC Sidecar — Locks",
  "description": "Signed lock records — a derived view of 'lock'/'unlock' events. Carried inside an OMC Asset's customData under domain 'dwc.sidecar.locks'. A lock is EITHER single-signer (legacy: one 'sig') OR an m-of-n threshold lock (a 'policy' naming the eligible kids and the count required, plus a 'sigs' array of co-signatures). Every co-signature in a threshold lock signs the SAME bytes — JCS(lock minus 'sig'/'sigs') — so the policy itself is under every signature; editing m or of invalidates all of them. Cross-reference to the corresponding signed event entries and the count of valid event-backed co-signers are enforced outside JSON Schema (Stage 5).",

  "type": "array",
  "minItems": 0,
  "items": { "$ref": "#/$defs/lock" },

  "$defs": {
    "urn": {
      "type": "string",
      "pattern": "^urn:[a-z0-9][a-z0-9-]{0,31}:[^\\s]+$"
    },

    "signature": {
      "type": "object",
      "required": ["alg", "kid", "value"],
      "additionalProperties": false,
      "properties": {
        "alg":   { "type": "string", "enum": ["ed25519", "ecdsa-p256", "rsa-pss"] },
        "kid":   { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },

    "policy": {
      "type": "object",
      "required": ["m", "of"],
      "additionalProperties": false,
      "description": "Threshold requirement: at least 'm' distinct kids drawn from 'of' must co-sign. 'of' must contain at least 'm' entries — enforced by the validator (Stage 5), since JSON Schema can't compare two sibling values.",
      "properties": {
        "m":  { "type": "integer", "minimum": 1 },
        "of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },

    "lock": {
      "type": "object",
      "required": ["target", "scope", "by", "at"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/urn" },
        "scope":  { "type": "string", "enum": ["artifact", "entity", "field"] },
        "field":  {
          "type": "string",
          "description": "JSON Pointer to the locked field. Required only when scope = 'field'.",
          "pattern": "^(/[^/~]*(~[01][^/~]*)*)+$"
        },
        "by":     { "$ref": "#/$defs/urn" },
        "at":     { "type": "string", "format": "date-time" },
        "reason": { "type": "string" },
        "sig":    { "$ref": "#/$defs/signature" },
        "policy": { "$ref": "#/$defs/policy" },
        "sigs":   {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/signature" }
        }
      },
      "allOf": [
        {
          "if":   { "properties": { "scope": { "const": "field" } } },
          "then": { "required": ["field"] }
        }
      ],
      "oneOf": [
        {
          "title": "single-signer lock",
          "required": ["sig"],
          "not": { "anyOf": [ { "required": ["policy"] }, { "required": ["sigs"] } ] }
        },
        {
          "title": "m-of-n threshold lock",
          "required": ["policy", "sigs"],
          "not": { "required": ["sig"] }
        }
      ]
    }
  }
}
