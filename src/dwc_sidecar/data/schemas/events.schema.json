{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ns.the-dwc.com/sidecar/v0.2/events.schema.json",
  "title": "DWC Sidecar — Events (append-only provenance log)",
  "description": "Hash-chained, signed event log. Carried inside an OMC Asset's customData under domain 'dwc.sidecar.events'. Chain integrity (prevHash linkage, seq monotonicity) is enforced outside JSON Schema; this schema only validates per-event shape. v0.2 adds the optional 'artifacts' commitment array so the signed event body covers the integrity hashes of the files it references. A two-party custody hand-off is a 'transfer' event (sender-signed offer, carrying transfer.to and re-committing the artifacts being handed over) followed by an 'accept' event (receiver-signed, committing by hash to the offer via transfer.of/from). The sender↔receiver binding is enforced outside JSON Schema (Stage 3.5).",

  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/event" },

  "$defs": {
    "urn": {
      "type": "string",
      "pattern": "^urn:[a-z0-9][a-z0-9-]{0,31}:[^\\s]+$"
    },

    "chainHash": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|sha512:[0-9a-f]{128}|blake3:[0-9a-f]{64})$"
    },

    "artifactHash": {
      "type": "object",
      "required": ["alg", "value"],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "type": "string",
          "enum": ["c4", "xxh64", "xxh3", "md5", "sha1", "sha256", "sha512", "blake3"]
        },
        "value": { "type": "string", "minLength": 8 }
      }
    },

    "artifactCommitment": {
      "type": "object",
      "required": ["id", "hash"],
      "additionalProperties": false,
      "properties": {
        "id":   { "$ref": "#/$defs/urn" },
        "hash": { "$ref": "#/$defs/artifactHash" }
      }
    },

    "signature": {
      "type": "object",
      "required": ["alg", "kid", "value"],
      "additionalProperties": false,
      "properties": {
        "alg":   { "type": "string", "enum": ["ed25519", "ecdsa-p256", "rsa-pss"] },
        "kid":   { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },

    "actor": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id":   { "$ref": "#/$defs/urn" },
        "role": { "type": "string" }
      }
    },

    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Two-party custody hand-off. On a 'transfer' (offer): 'to' names the receiver. On an 'accept': 'of' is the chainHash of the offer event being counter-signed and 'from' names the offering actor. The required-field rules per action are expressed in the event's allOf below.",
      "properties": {
        "to":   { "$ref": "#/$defs/urn" },
        "from": { "$ref": "#/$defs/urn" },
        "of":   { "$ref": "#/$defs/chainHash" }
      }
    },

    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name":    { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },

    "event": {
      "type": "object",
      "required": ["seq", "ts", "actor", "tool", "action", "target", "prevHash", "hash", "sig"],
      "additionalProperties": false,
      "properties": {
        "seq":      { "type": "integer", "minimum": 1 },
        "ts":       { "type": "string", "format": "date-time" },
        "actor":    { "$ref": "#/$defs/actor" },
        "tool":     { "$ref": "#/$defs/tool" },
        "action": {
          "type": "string",
          "enum": [
            "create", "attach", "detach", "update",
            "lock", "unlock",
            "sign", "verify",
            "supersede", "transfer", "accept"
          ]
        },
        "target":   { "$ref": "#/$defs/urn" },
        "transfer": { "$ref": "#/$defs/transfer" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifactCommitment" },
          "description": "Integrity commitments: the {alg,value} hash of each referenced artifact, inside the signed event body. Validators crosscheck these against the dwc.sidecar.artifacts block (Stage 3.5)."
        },
        "prevHash": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/chainHash" }
          ]
        },
        "hash":     { "$ref": "#/$defs/chainHash" },
        "sig":      { "$ref": "#/$defs/signature" }
      },
      "allOf": [
        {
          "if":   { "properties": { "seq": { "const": 1 } } },
          "then": { "properties": { "prevHash": { "type": "null" } } }
        },
        {
          "if":   { "properties": { "seq": { "not": { "const": 1 } } } },
          "then": { "properties": { "prevHash": { "$ref": "#/$defs/chainHash" } } }
        },
        {
          "if":   { "required": ["action"], "properties": { "action": { "const": "transfer" } } },
          "then": { "required": ["transfer"],
                    "properties": { "transfer": { "required": ["to"] } } }
        },
        {
          "if":   { "required": ["action"], "properties": { "action": { "const": "accept" } } },
          "then": { "required": ["transfer"],
                    "properties": { "transfer": { "required": ["of", "from"] } } }
        }
      ]
    }
  }
}
